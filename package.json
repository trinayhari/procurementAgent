{
  "name": "proq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "(cd backend && ${PYTHON:-.venv/bin/python} scripts/export_openapi.py) && openapi-typescript backend/openapi.json -o src/api-types.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.11"
  }
}
