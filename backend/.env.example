# Copy to .env to override defaults. All vars are prefixed with PROCUREAI_.
# PROCUREAI_APP_NAME=ProcureAI API
# Comma/JSON list of browser origins allowed to call the API:
# PROCUREAI_CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---------------------------------------------------------------
# All app data persists here. Defaults to a local SQLite file (zero-config).
# For the Postgres stack: `docker compose up -d` (see docker-compose.yml), then:
# PROCUREAI_DATABASE_URL=postgresql+psycopg2://procureai:procureai@localhost:5432/procureai
# Default (SQLite):
# PROCUREAI_DATABASE_URL=sqlite:///./procureai.db

# --- Auth (JWT) -------------------------------------------------------------
# Secret used to sign access tokens. MUST be set to a long random value in
# production (e.g. `openssl rand -hex 32`). The default is insecure.
# PROCUREAI_JWT_SECRET=change-me-to-a-long-random-string
# PROCUREAI_JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 7 days):
# PROCUREAI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Seeded demo login on a fresh DB: jordan@meridiancivil.com / procureai

# --- File uploads -----------------------------------------------------------
# PROCUREAI_UPLOAD_DIR=uploads
# PROCUREAI_MAX_UPLOAD_MB=500

# --- GPT-4.1 vision extraction ----------------------------------------------
# Set the key to enable live extraction; leave empty for a flagged mock.
# PROCUREAI_OPENAI_API_KEY=sk-...
# Optional: point at an OpenAI-compatible gateway (e.g. OpenRouter). When using
# OpenRouter, set the key to sk-or-... and the model to "openai/gpt-4.1".
# PROCUREAI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# PROCUREAI_OPENAI_VISION_MODEL=gpt-4.1
# PROCUREAI_VISION_DPI=150
# PROCUREAI_VISION_MAX_PAGES=30
# PROCUREAI_VISION_IMAGE_DETAIL=high
# PROCUREAI_VISION_MAX_TOKENS=8000

# --- Google Maps (supplier discovery) ---------------------------------------
# Geocoding + Places. Leave empty for a flagged mock supplier search.
# PROCUREAI_GOOGLE_MAPS_API_KEY=

# --- Gmail (RFQ send + quote-reply ingest) ----------------------------------
# Mint once with scripts/mint_gmail_token.py (requests gmail.send + gmail.readonly).
# A send-only token still sends RFQs, but quote ingest needs the readonly scope —
# re-mint if you minted before this scope was added. Empty creds → mock send and
# simulated quotes so the whole quote→compare flow works offline.
# PROCUREAI_GMAIL_CLIENT_ID=
# PROCUREAI_GMAIL_CLIENT_SECRET=
# PROCUREAI_GMAIL_REFRESH_TOKEN=
# PROCUREAI_GMAIL_SENDER_ADDRESS=you@gmail.com
# How far back the quote-ingest poller scans for supplier replies:
# PROCUREAI_QUOTE_INGEST_LOOKBACK_DAYS=30
